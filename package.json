{
  "name": "customer-health-mcp",
  "version": "0.1.0",
  "description": "MCP server that synthesizes mock billing, support, and product usage data into B2B SaaS customer health and churn-risk insights.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "customer-health-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "sample-data": "tsx src/data/printSample.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "customer-health",
    "churn-risk"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=18"
  }
}
